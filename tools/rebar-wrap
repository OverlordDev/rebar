#!/usr/bin/env python3
"""rebar-wrap: make arm64-only Mac apps start by themselves through rebar (double click, Dock, `open`, file associations).

The kernel of an Intel Mac refuses an arm64-only executable ("Bad CPU type"), and nothing between a Finder double click and the kernel can be hooked. What can be changed is
the executable: the main executable of the app (CFBundleExecutable) becomes a universal file, the original arm64 slice plus a tiny x86_64 program (tools/rebar_wrap_shim.c).
The kernel runs the x86_64 slice, which replaces itself with `rebar <that same file>`; rebar reads the arm64 slice. The bundle, its Info.plist, its icon and its pid are unchanged.

    rebar-wrap enable  <App.app|folder> ...   wrap the arm64-only apps (a folder: every .app directly inside it)
    rebar-wrap disable <App.app|folder> ...   put the original executable back
    rebar-wrap list    [--json] [<App.app|folder> ...]   the arm64-only apps of the watched folders (and those given) with their state (the launcher's Wrapper window uses --json)
    rebar-wrap wrap-tree <dir>                wrap every arm64-only executable file below a folder in place (test copies)
    rebar-wrap env     <App.app> [KEY=VALUE ...]  the environment a wrapped app starts with (Steam ids, REBAR_* switches); no pairs: show it
    rebar-wrap update  <App.app|folder> ...   replace the shim of wrapped apps by the current one
    rebar-wrap seal    <App.app|folder> ...   sign the bundle of wrapped apps (enable does it for downloaded ones: Gatekeeper calls a downloaded app with a stale seal damaged)
    rebar-wrap status  [<App.app|folder> ...] what is arm64-only / wrapped (default: the folders of `auto`)
    rebar-wrap auto                           enable for the watched folders (what the agent runs)
    rebar-wrap agent install | uninstall | status     a LaunchAgent that runs `auto` whenever a watched folder changes
    rebar-wrap setup                          only record where rebar is (done by every command)

The original executable is kept in ~/Library/Application Support/rebar/wrapped/ (disable restores it byte for byte, with its signature). The wrapped executable is signed ad hoc, which
is all an unsigned-by-Apple program needs on this Mac. Apps that update themselves replace the file: `auto` (or the agent) wraps them again.
Watched folders: /Applications, ~/Applications and any listed one per line in ~/Library/Application Support/rebar/autowrap-folders.
"""
import glob, hashlib, os, plistlib, shutil, struct, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)
SUPPORT = os.path.expanduser("~/Library/Application Support/rebar")
STORE = os.path.join(SUPPORT, "wrapped")
LABEL = os.environ.get("REBAR_WRAP_LABEL", "com.rebar.autowrap")   # (another label: for tests)
AGENT = os.path.expanduser("~/Library/LaunchAgents/%s.plist" % LABEL)
MARK = b"REBAR-WRAPPED-1"   # (inside the shim: how a wrapped file is recognised)

CPU_ARM64, CPU_X86_64 = 0x0100000C, 0x01000007


def rebar_binary():
    for c in (os.environ.get("REBAR_BIN"), os.path.join(ROOT, "rebar"), "/usr/local/bin/rebar"):
        if c and os.access(c, os.X_OK):
            return os.path.realpath(c)
    sys.exit("rebar-wrap: rebar not found (build it with ./build.sh, or set REBAR_BIN)")


def slices(path):
    """The CPU types of a Mach-O file ([] for anything else)."""
    try:
        with open(path, "rb") as f:
            b = f.read(4096)
    except OSError:
        return []
    if len(b) < 32:
        return []
    if struct.unpack("<I", b[:4])[0] == 0xFEEDFACF:
        return [struct.unpack("<I", b[4:8])[0]]
    if b[:4] == b"\xca\xfe\xba\xbe":
        n = struct.unpack(">I", b[4:8])[0]
        return [struct.unpack(">I", b[8 + 20 * i:12 + 20 * i])[0] for i in range(min(n, 8))]
    return []


def is_wrapped(path):
    try:
        with open(path, "rb") as f:
            data = f.read(1 << 20)   # (the x86_64 slice comes first and is small)
    except OSError:
        return False
    return MARK in data


def main_executable(app):
    try:
        with open(os.path.join(app, "Contents", "Info.plist"), "rb") as f:
            exe = plistlib.load(f).get("CFBundleExecutable")
    except Exception:
        return None
    return os.path.join(app, "Contents", "MacOS", exe) if exe else None


def arm64_only(path):
    s = slices(path)
    return CPU_ARM64 in s and CPU_X86_64 not in s


def store_name(exe):
    return hashlib.sha1(os.path.realpath(exe).encode()).hexdigest()[:16]


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def build_shim():
    """The x86_64 shim: $REBAR_WRAP_SHIM (the launcher ships it compiled), else compiled once from the source and cached next to the originals."""
    for pre in (os.environ.get("REBAR_WRAP_SHIM"), os.path.join(HERE, "rebar_wrap_shim"), os.path.join(ROOT, "rebar_wrap_shim")):   # (the release zip has it compiled next to this file)
        if pre and os.path.isfile(pre) and os.access(pre, os.X_OK):
            return pre
    os.makedirs(SUPPORT, exist_ok=True)
    out = os.path.join(SUPPORT, "rebar_wrap_shim")
    src = os.path.join(HERE, "rebar_wrap_shim.c")
    if not os.path.exists(out) or os.path.getmtime(out) < os.path.getmtime(src):
        r = run(["clang", "-arch", "x86_64", "-O2", "-Wall", src, "-o", out])
        if r.returncode:
            sys.exit("rebar-wrap: cannot build the shim:\n" + r.stderr)
    return out


def setup():
    os.makedirs(SUPPORT, exist_ok=True)
    with open(os.path.join(SUPPORT, "rebar-path"), "w") as f:
        f.write(rebar_binary() + "\n")


def quarantined(app):
    return "com.apple.quarantine" in (run(["xattr", app]).stdout or "")


def _resources_hash(app):
    try:
        with open(os.path.join(app, "Contents", "_CodeSignature", "CodeResources"), "rb") as f:
            return hashlib.sha1(f.read()).hexdigest()
    except OSError:
        return ""


def seal_bundle(app):
    """Sign the whole bundle ad hoc (not its nested code: that keeps its own signature). A downloaded app (quarantine attribute) is checked by Gatekeeper as a bundle on its first
    start and a main executable that no longer matches the bundle's seal makes it "damaged"; with a valid seal it is an app of an unidentified developer, which the user can allow
    in System Settings > Privacy & Security. The original seal (_CodeSignature) is kept for disable."""
    exe = main_executable(app)
    keep = os.path.join(STORE, store_name(exe))
    os.makedirs(keep, exist_ok=True)
    sig = os.path.join(app, "Contents", "_CodeSignature")
    saved, marker = os.path.join(keep, "_CodeSignature"), os.path.join(keep, "sealed")
    try:
        ours = open(marker).read().strip()
    except OSError:
        ours = ""
    if os.path.isdir(sig) and (not ours or ours != _resources_hash(app)):   # (not made by us: the app's own seal, the one to keep)
        shutil.rmtree(saved, ignore_errors=True)
        shutil.copytree(sig, saved, symlinks=True)
    r = run(["codesign", "--force", "-s", "-", app])
    if r.returncode:
        return "codesign failed: " + r.stderr.strip()
    with open(marker, "w") as f:
        f.write(_resources_hash(app) + "\n")
    return "bundle signed"


def enable(app, quiet=False):
    app = app.rstrip("/")
    exe = main_executable(app)
    if not exe or not os.path.isfile(exe):
        return "no main executable"
    if is_wrapped(exe):
        return "already wrapped" + (", " + seal_bundle(app) if quarantined(app) and run(["codesign", "--verify", app]).returncode != 0 else "")
    if not arm64_only(exe):
        return "not arm64-only (runs natively)"
    shim = build_shim()
    setup()
    os.makedirs(STORE, exist_ok=True)
    keep = os.path.join(STORE, store_name(exe))
    os.makedirs(keep, exist_ok=True)
    orig = os.path.join(keep, "original")
    shutil.copy2(exe, orig)   # (kept as it was: disable puts exactly this back)
    with open(os.path.join(keep, "path"), "w") as f:
        f.write(os.path.realpath(exe) + "\n")
    tmp = exe + ".rebar-wrap"
    marked = os.path.join(keep, "shim")
    with open(shim, "rb") as a, open(marked, "wb") as b:
        b.write(a.read())   # (the marker is a string inside the shim itself, see below)
    r = run(["lipo", "-create", "-arch", "x86_64", marked, "-arch", "arm64", orig, "-output", tmp])
    if r.returncode:
        os.path.exists(tmp) and os.remove(tmp)
        return "lipo failed: " + r.stderr.strip()
    os.chmod(tmp, 0o755)
    r = run(["codesign", "--force", "-s", "-", tmp])
    if r.returncode:
        os.remove(tmp)
        return "codesign failed: " + r.stderr.strip()
    os.replace(tmp, exe)
    if quarantined(app):
        return "wrapped, " + seal_bundle(app)
    return "wrapped"


def disable(app):
    app = app.rstrip("/")
    exe = main_executable(app)
    if not exe or not os.path.isfile(exe):
        return "no main executable"
    if not is_wrapped(exe):
        return "not wrapped"
    keep = os.path.join(STORE, store_name(exe))
    orig = os.path.join(keep, "original")
    if os.path.exists(orig):
        shutil.copy2(orig, exe + ".rebar-wrap")
        os.replace(exe + ".rebar-wrap", exe)
        saved, sig = os.path.join(keep, "_CodeSignature"), os.path.join(app, "Contents", "_CodeSignature")
        if os.path.exists(os.path.join(keep, "sealed")) and os.path.isdir(saved):   # (the bundle was sealed by us: the app's own seal goes back as well)
            shutil.rmtree(sig, ignore_errors=True)
            shutil.copytree(saved, sig, symlinks=True)
            os.remove(os.path.join(keep, "sealed"))
        return "restored from the saved original"
    tmp = exe + ".rebar-wrap"
    r = run(["lipo", "-thin", "arm64", exe, "-output", tmp])   # (no saved original: the arm64 slice is the app)
    if r.returncode:
        return "lipo failed: " + r.stderr.strip()
    os.chmod(tmp, 0o755)
    run(["codesign", "--force", "-s", "-", tmp])
    os.replace(tmp, exe)
    return "arm64 slice put back (signed ad hoc)"


def apps_in(arg):
    arg = os.path.expanduser(arg).rstrip("/")
    if arg.endswith(".app"):
        return [arg]
    return sorted(glob.glob(arg + "/*.app"))


def watched():
    if os.environ.get("REBAR_WRAP_FOLDERS"):   # (colon-separated, instead of the usual ones: for tests)
        return [x for x in os.environ["REBAR_WRAP_FOLDERS"].split(":") if os.path.isdir(x)]
    d = ["/Applications", os.path.expanduser("~/Applications")]
    try:
        with open(os.path.join(SUPPORT, "autowrap-folders")) as f:
            d += [os.path.expanduser(l.strip()) for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        pass
    return [x for x in d if os.path.isdir(x)]


def cmd_status(args):
    for a in [x for arg in (args or watched()) for x in apps_in(arg)]:
        exe = main_executable(a)
        if not exe or not os.path.isfile(exe):
            continue
        if is_wrapped(exe):
            print("wrapped     ", a)
        elif arm64_only(exe):
            print("arm64-only  ", a)


def rest_nojson(rest):
    return [x for x in rest if not x.startswith("--")]


def agent_plist():
    return {
        "Label": LABEL,
        "ProgramArguments": ["/usr/bin/python3", os.path.realpath(__file__), "auto"],
        "WatchPaths": watched(),
        "ThrottleInterval": 20,
        "RunAtLoad": False,
        "EnvironmentVariables": dict({"REBAR_BIN": rebar_binary(), "PATH": "/usr/bin:/bin:/usr/sbin:/sbin"}, **({"REBAR_WRAP_SHIM": os.environ["REBAR_WRAP_SHIM"]} if os.environ.get("REBAR_WRAP_SHIM") else {}),
                                     **({"REBAR_WRAP_FOLDERS": os.environ["REBAR_WRAP_FOLDERS"]} if os.environ.get("REBAR_WRAP_FOLDERS") else {})),
        "StandardErrorPath": os.path.join(SUPPORT, "autowrap.log"),
        "StandardOutPath": os.path.join(SUPPORT, "autowrap.log"),
    }


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__); return
    cmd, rest = a[0], a[1:]
    if cmd == "setup":
        setup(); print("rebar:", rebar_binary()); return
    if cmd in ("enable", "disable"):
        if not rest:
            sys.exit("usage: rebar-wrap %s <App.app|folder> ..." % cmd)
        fn = enable if cmd == "enable" else disable
        for arg in rest:
            for app in apps_in(arg):
                exe = main_executable(app)
                if cmd == "enable" and exe and os.path.isfile(exe) and not arm64_only(exe) and not is_wrapped(exe):
                    continue   # (a folder: say nothing about the apps that run natively)
                print("%s: %s" % (os.path.basename(app), fn(app)))
        return
    if cmd == "wrap-tree":   # rebar-wrap wrap-tree <dir>: every arm64-only executable file below it (not a dylib, not an app) becomes shim + arm64 slice, in place, nothing saved (for test copies)
        shim = build_shim(); setup(); n = 0
        for d, dirs, files in os.walk(rest[0] if rest else "."):
            for fn in files:
                path = os.path.join(d, fn)
                if os.path.islink(path) or not os.path.isfile(path):
                    continue
                try:
                    with open(path, "rb") as f:
                        h = f.read(16)
                except OSError:
                    continue
                if len(h) < 16 or struct.unpack("<I", h[:4])[0] != 0xFEEDFACF or struct.unpack("<I", h[4:8])[0] != CPU_ARM64:
                    continue
                if struct.unpack("<I", h[12:16])[0] != 2 or (struct.unpack("<I", h[8:12])[0] & 0xFF) == 2:   # (MH_EXECUTE only; arm64e needs pointer authentication)
                    continue
                tmp = path + ".rebar-wrap"
                if run(["lipo", "-create", "-arch", "x86_64", shim, "-arch", "arm64", path, "-output", tmp]).returncode:
                    continue
                os.chmod(tmp, os.stat(path).st_mode & 0o777 | 0o111)
                run(["codesign", "--force", "-s", "-", tmp])
                os.replace(tmp, path); n += 1
        print("wrapped %d executable(s)" % n)
        return
    if cmd == "list":   # rebar-wrap list [--json] [<App.app|folder> ...]: the arm64-only apps (wrapped or not) with the environment they start with
        import json
        out = []
        seen = set()
        for a in [x for arg in (watched() + rest_nojson(rest)) for x in apps_in(arg)]:
            if a in seen:
                continue
            seen.add(a)
            exe = main_executable(a)
            if not exe or not os.path.isfile(exe):
                continue
            w = is_wrapped(exe)
            if not (w or arm64_only(exe)):
                continue
            envf = os.path.join(SUPPORT, "env", os.path.basename(exe))
            out.append({"path": a, "name": os.path.basename(a)[:-4], "wrapped": w, "quarantined": quarantined(a),
                        "writable": os.access(os.path.dirname(exe), os.W_OK), "env": open(envf).read() if os.path.exists(envf) else ""})
        if "--json" in rest:
            print(json.dumps(out))
        else:
            for o in out:
                print("%-8s %s" % ("wrapped" if o["wrapped"] else "arm64", o["path"]))
        return
    if cmd == "env":   # rebar-wrap env <App.app> [KEY=VALUE ...]: the environment the wrapped app starts with (no pairs: show it)
        if not rest:
            sys.exit("usage: rebar-wrap env <App.app> [KEY=VALUE ...]")
        exe = main_executable(rest[0].rstrip("/"))
        if not exe:
            sys.exit("rebar-wrap: no such app")
        f = os.path.join(SUPPORT, "env", os.path.basename(exe))
        if rest[1:] == ["--clear"]:
            os.path.exists(f) and os.remove(f)
        elif len(rest) > 1:
            os.makedirs(os.path.dirname(f), exist_ok=True)
            with open(f, "w") as o:
                o.write("".join(x + "\n" for x in rest[1:]))
        print(open(f).read() if os.path.exists(f) else "(none)", end="")
        return
    if cmd == "update":   # the shim of wrapped apps is replaced by the current one (after tools/rebar_wrap_shim.c changed)
        shim = build_shim()
        for arg in rest:
            for app in apps_in(arg):
                exe = main_executable(app)
                if not (exe and os.path.isfile(exe) and is_wrapped(exe)):
                    continue
                arm, tmp, out = exe + ".rebar-arm64", exe + ".rebar-wrap", None
                r = run(["lipo", "-thin", "arm64", exe, "-output", arm])
                if r.returncode == 0:
                    r = run(["lipo", "-create", "-arch", "x86_64", shim, "-arch", "arm64", arm, "-output", tmp])
                os.path.exists(arm) and os.remove(arm)
                if r.returncode:
                    print("%s: lipo failed: %s" % (os.path.basename(app), r.stderr.strip())); continue
                os.chmod(tmp, 0o755)
                run(["codesign", "--force", "-s", "-", tmp])
                os.replace(tmp, exe)
                print("%s: shim updated" % os.path.basename(app))
        return
    if cmd == "seal":   # (sign the bundle of wrapped apps: what enable does for a downloaded app)
        for arg in rest:
            for app in apps_in(arg):
                exe = main_executable(app)
                if exe and os.path.isfile(exe) and is_wrapped(exe):
                    print("%s: %s" % (os.path.basename(app), seal_bundle(app)))
        return
    if cmd == "status":
        cmd_status(rest); return
    if cmd == "auto":
        for d in watched():
            for app in apps_in(d):
                exe = main_executable(app)
                if exe and os.path.isfile(exe) and arm64_only(exe) and not is_wrapped(exe):
                    print("%s: %s" % (app, enable(app)), flush=True)
        return
    if cmd == "agent":
        sub = rest[0] if rest else ""
        uid = str(os.getuid())
        if sub == "install":
            os.makedirs(os.path.dirname(AGENT), exist_ok=True); os.makedirs(SUPPORT, exist_ok=True)
            with open(AGENT, "wb") as f:
                plistlib.dump(agent_plist(), f)
            run(["launchctl", "bootout", "gui/" + uid + "/" + LABEL])
            r = run(["launchctl", "bootstrap", "gui/" + uid, AGENT])
            print(r.stderr.strip() or "agent installed: %s watches %s" % (LABEL, ", ".join(watched())))
        elif sub == "status":   # exit status 0 and "installed" when launchd has the agent
            on = os.path.exists(AGENT) and run(["launchctl", "print", "gui/" + uid + "/" + LABEL]).returncode == 0
            print("installed" if on else "not installed"); sys.exit(0 if on else 1)
        elif sub == "uninstall":
            run(["launchctl", "bootout", "gui/" + uid + "/" + LABEL])
            os.path.exists(AGENT) and os.remove(AGENT)
            print("agent removed (wrapped apps stay wrapped: rebar-wrap disable <folder> puts them back)")
        else:
            sys.exit("usage: rebar-wrap agent install|uninstall|status")
        return
    sys.exit("unknown command %r (rebar-wrap help)" % cmd)


if __name__ == "__main__":
    main()
